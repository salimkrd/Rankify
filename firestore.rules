rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }

    // Helper functions for user ownership
    function isDocOwner() {
      return isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    function isCreatingForSelf() {
      return isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // Helper function: Check if user owns the parent event
    function isEventOwner(eventId) {
      return isAuthenticated() &&
        eventId != null &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.user_id == request.auth.uid;
    }

    // Template ownership: direct ownership or verified parent event ownership for legacy records
    function canReadTemplate() {
      return isAuthenticated() && (
        isDocOwner() ||
        (
          (!('user_id' in resource.data) || resource.data.user_id == null) &&
          (
            ('event_id' in resource.data && isEventOwner(resource.data.event_id)) ||
            ('eventId' in resource.data && isEventOwner(resource.data.eventId))
          )
        )
      );
    }

    function canUpdateTemplate() {
      return isAuthenticated() && (
        (isDocOwner() && request.resource.data.user_id == resource.data.user_id) ||
        (
          (!('user_id' in resource.data) || resource.data.user_id == null) &&
          (
            ('event_id' in resource.data && isEventOwner(resource.data.event_id)) ||
            ('eventId' in resource.data && isEventOwner(resource.data.eventId))
          ) &&
          request.resource.data.user_id == request.auth.uid
        )
      );
    }

    // Core User Collections: events, teams, categories, participants
    match /events/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    match /teams/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    match /categories/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    match /participants/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    // Templates
    match /program_templates/{docId} {
      allow read, delete: if canReadTemplate();
      allow create: if isCreatingForSelf();
      allow update: if canUpdateTemplate();
    }

    match /team_status_templates/{docId} {
      allow read, delete: if canReadTemplate();
      allow create: if isCreatingForSelf();
      allow update: if canUpdateTemplate();
    }

    match /framed_post_templates/{docId} {
      allow read, delete: if canReadTemplate();
      allow create: if isCreatingForSelf();
      allow update: if canUpdateTemplate();
    }

    match /certificate_templates/{docId} {
      allow read, delete: if canReadTemplate();
      allow create: if isCreatingForSelf();
      allow update: if canUpdateTemplate();
    }

    // Results & Posts
    match /program_results/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    match /team_status_results/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    match /framed_posts/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    match /certificate_results/{docId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
      allow update: if isDocOwner() && request.resource.data.user_id == resource.data.user_id;
    }

    // Public Templates: readable by anyone if published, manageable by admin
    match /public_templates/{docId} {
      allow read: if resource.data.is_published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Admin Users directory collection
    // - Authenticated users can read their own record to verify their access.
    // - Existing admins can view all admin records.
    // - STRICT: Client-side creation/modification is prohibited unless already an admin.
    // - Initial admin assignment is managed via trusted Firebase Admin SDK or Firebase Console.
    match /admin_users/{docId} {
      allow read: if isAuthenticated() && (
        docId == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      allow write: if isAdmin();
    }
  }
}
